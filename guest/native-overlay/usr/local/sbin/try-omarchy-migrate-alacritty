#!/usr/bin/python3 -I
"""Retire the factory workaround and safely clean up an uninstalled launcher."""

import errno
import hashlib
import os
from pathlib import Path
import stat
import shutil
import sys

MARKER = "omarchy.virgl_dual_source=1"
WRAPPER_SHA256 = "9f2da34ccfbbf5402233c1e19ca09197c03c8a7fda3369e4adaaff2d5df7c67e"
WRAPPER_SIZE = 688
BACKUP = ".alacritty.try-omarchy-software-backup"


def open_directory(path):
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in Path(path).parts[1:]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
        return descriptor
    except OSError:
        os.close(descriptor)
        raise


def migrate(cmdline=Path("/proc/cmdline"), directory=Path("/usr/local/bin"), trusted_uid=0,
            binary=Path("/usr/bin/alacritty")):
    # A leftover wrapper satisfies desktop TryExec even after the package (and
    # its icon) is removed. Keep the rendering guard only for installed Alacritty.
    installed = os.access(binary, os.X_OK)
    if installed and MARKER not in cmdline.read_text().split():
        return "Skipped: this boot does not advertise the fixed VirGL runtime."

    message = ("Migrated: the factory Alacritty wrapper was backed up; accelerated rendering is enabled."
               if installed else
               "Migrated: the unused factory Alacritty wrapper was backed up; run --launcher without sudo to clean up Apps.")
    return retire_factory_file(directory, trusted_uid, "alacritty", BACKUP,
                               WRAPPER_SHA256, WRAPPER_SIZE, "Alacritty wrapper", message)


def retire_factory_file(directory, trusted_uid, name, backup, digest, size, label, success_message):
    parent = open_directory(directory)
    try:
        info = os.fstat(parent)
        if info.st_uid != trusted_uid or info.st_mode & 0o022:
            return f"Preserved: the {label} directory is not protected."
        try:
            source = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=parent)
        except FileNotFoundError:
            return f"No migration needed: no {label} is installed."
        except OSError as error:
            if error.errno == errno.ELOOP:
                return f"Preserved: the {label} is a symbolic link."
            raise
        try:
            original = os.fstat(source)
            if (not stat.S_ISREG(original.st_mode) or original.st_uid != trusted_uid
                    or original.st_mode & 0o022 or original.st_nlink != 1):
                return f"Preserved: the {label} is not an unmodified factory file."
            content = os.read(source, size + 1)
            if hashlib.sha256(content).hexdigest() != digest:
                return f"Preserved: the {label} has custom contents."
            try:
                # An exclusive hard link preserves the original bytes and metadata
                # before removing the original entry, without overwriting any backup.
                os.link(name, backup, src_dir_fd=parent, dst_dir_fd=parent,
                        follow_symlinks=False)
            except FileExistsError:
                return "Preserved: an Alacritty migration backup already exists."
            for entry_name in (name, backup):
                current = os.stat(entry_name, dir_fd=parent, follow_symlinks=False)
                if (current.st_dev, current.st_ino) != (original.st_dev, original.st_ino):
                    raise RuntimeError("File changed during migration; no original entry was removed.")
            os.unlink(name, dir_fd=parent)
            os.fsync(parent)
            return success_message
        finally:
            os.close(source)
    finally:
        os.close(parent)


LAUNCHER_SHA256 = "713703ba90ff8cd8d66eeb2804202e05e0c80c48e651ad00b9b7276f3d057683"
LAUNCHER_SIZE = 452
LAUNCHER_BACKUP = ".Alacritty.desktop.try-omarchy-backup"


def cleanup_launcher(directory=None, search_path=None):
    # Run as the desktop user, never edit another user's home as root.
    if os.geteuid() == 0:
        return "Preserved: run --launcher as your desktop user without sudo."
    if shutil.which("alacritty", path=search_path):
        return "Preserved: Alacritty is still available; retire the unused factory wrapper first."
    if directory is None:
        data_home = os.environ.get("XDG_DATA_HOME", "")
        if not data_home or not Path(data_home).is_absolute():
            data_home = Path.home() / ".local/share"
        directory = Path(data_home) / "applications"
    if not directory.exists():
        return "No migration needed: no user applications directory exists."
    return retire_factory_file(directory, os.getuid(), "Alacritty.desktop", LAUNCHER_BACKUP,
                               LAUNCHER_SHA256, LAUNCHER_SIZE, "Alacritty launcher",
                               "Migrated: the stale Alacritty launcher was backed up and removed from Apps.")


def main():
    launcher = sys.argv[1:] == ["--launcher"]
    if len(sys.argv) != 1 and not launcher:
        print("Usage: sudo try-omarchy-migrate-alacritty | try-omarchy-migrate-alacritty --launcher", file=sys.stderr)
        return 2
    if not launcher and os.geteuid() != 0:
        print("Run this migration with sudo.", file=sys.stderr)
        return 1
    try:
        print(cleanup_launcher() if launcher else migrate())
    except (OSError, RuntimeError) as error:
        print(f"Alacritty migration failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
